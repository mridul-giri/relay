API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relay
REDIS_URL=redis://localhost:6379

# Voice (required: the engine calls through LiveKit; the agent's STT, TTS, and
# LLM go through LiveKit's inference gateway, so only the LiveKit project
# credentials are needed). TTS_VOICE is provider-specific; leave empty for the
# provider default.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TTS_VOICE=
