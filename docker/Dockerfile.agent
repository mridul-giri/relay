FROM oven/bun:1

WORKDIR /usr/src/app

COPY ./package.json ./package.json
COPY ./bun.lock ./bun.lock

COPY ./packages ./packages

COPY ./apps/agent ./apps/agent

RUN bun install

RUN cd packages/db && bunx prisma generate

WORKDIR /usr/src/app/apps/agent

CMD ["bun", "run", "src/index.ts", "start"]
