generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  calls Call[]
}

model Call {
  id         String       @id
  requestId  String       @unique
  roomName   String       @unique
  merchantId String
  orderRef   String
  status     CallStatus   @default(QUEUED)
  outcome    CallOutcome?

  customerName     String
  customerPhone    String
  customerLanguage String  @default("en")
  driverName       String?
  driverPhone      String?
  productName      String?
  productSku       String?
  etaMinutes       Int
  message          String?

  policy       Json
  offeredSlots Json
  chosenSlot   Json?

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  merchant    Merchant         @relation(fields: [merchantId], references: [id])
  transcripts TranscriptTurn[]

  @@index([merchantId, createdAt])
}

model TranscriptTurn {
  id        String            @id @default(uuid())
  callId    String
  speaker   TranscriptSpeaker
  text      String
  spokenAt  DateTime
  createdAt DateTime          @default(now())

  call Call @relation(fields: [callId], references: [id])
}

enum CallStatus {
  QUEUED
  CALLING
  ENDED
}

enum CallOutcome {
  RESCHEDULED
  CANCELLATION_REQUESTED
  HUMAN_REQUESTED
  NO_DECISION
  NO_ANSWER
  FAILED
}

enum TranscriptSpeaker {
  AGENT
  CALLER
}
