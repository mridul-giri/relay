generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Trip {
  id                String     @id
  status            TripStatus
  driverName        String
  driverPhone       String
  customerName      String
  customerPhone     String
  plannedEtaMinutes Int
  etaMinutes        Int
  slot              String?
  note              String?
  delayReason       String?
  version           Int        @default(1)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  events       TripEvent[]
  auditLogs    AuditLog[]
  callAttempts CallAttempt[]
  escalations  Escalation[]

  @@index([createdAt, id])
}

model TripEvent {
  id            String   @id @default(uuid())
  eventId       String   @unique
  tripId        String
  type          String
  payload       Json
  occurredAt    DateTime
  versionBefore Int
  versionAfter  Int
  createdAt     DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  tripId    String
  type      String
  message   String
  data      Json?
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id])
}

model CallAttempt {
  id            String            @id @default(uuid())
  tripId        String
  persona       CallPersona
  reason        CallReason
  ruleId        String
  sourceEventId String
  status        CallAttemptStatus
  slots         Json
  createdAt     DateTime          @default(now())
  endedAt       DateTime?

  trip            Trip             @relation(fields: [tripId], references: [id])
  toolCalls       ToolCall[]
  transcriptTurns TranscriptTurn[]

  @@unique([tripId, ruleId, sourceEventId])
}

model TranscriptTurn {
  id            String            @id @default(uuid())
  callAttemptId String
  speaker       TranscriptSpeaker
  text          String
  spokenAt      DateTime
  createdAt     DateTime          @default(now())

  callAttempt CallAttempt @relation(fields: [callAttemptId], references: [id])
}

model ToolCall {
  id            String   @id @default(uuid())
  callAttemptId String
  tool          String
  args          Json
  accepted      Boolean
  reason        String
  createdAt     DateTime @default(now())

  callAttempt CallAttempt @relation(fields: [callAttemptId], references: [id])
}

model Escalation {
  id        String   @id @default(uuid())
  tripId    String
  ruleId    String
  reason    String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id])
}

enum TripStatus {
  ASSIGNED
  EN_ROUTE
  DELAYED
  RESCHEDULED
  DELIVERED
  ESCALATED
}

enum CallPersona {
  DRIVER
  CUSTOMER
}

enum CallReason {
  DELAY
}

enum CallAttemptStatus {
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum TranscriptSpeaker {
  AGENT
  CALLER
}
